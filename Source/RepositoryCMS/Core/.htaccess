DirectoryIndex app.php
Options -Indexes

RewriteEngine On

<Files "app.php">
    Require all granted
</Files>

<FilesMatch "^(?!app\.php$).+">
    Require all denied
</FilesMatch>

RewriteRule ^app\.php$ - [L]
RewriteRule ^$ app.php [L]
RewriteRule . app.php [L]

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
</IfModule>
